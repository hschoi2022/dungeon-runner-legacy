<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unity의 Assets/Scripts/Game.Core.Tests 소스를 NUnit으로 실행하는 CI용 프로젝트.
       실행: dotnet test ci/Game.Core.Tests.csproj -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>Game.Core.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Assets/Scripts/Game.Core.Tests/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="Game.Core.csproj" />
  </ItemGroup>
</Project>
